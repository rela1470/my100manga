{
  "name": "my100manga",
  "version": "0.1.0",
  "private": true,
  "description": "自分を構成する100の漫画を作って共有するサイト",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env=''",
    "deploy:dev": "wrangler deploy --env dev",
    "types": "wrangler types",
    "db:init:local": "wrangler d1 execute DB --local --file db/schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file db/schema.sql",
    "db:init:remote:dev": "wrangler d1 execute DB --env dev --remote --file db/schema.sql",
    "ingest:local": "node scripts/ingest.mjs --local",
    "ingest:remote": "node scripts/ingest.mjs --remote",
    "ingest:remote:dev": "node scripts/ingest.mjs --remote --env dev",
    "test": "vitest run",
    "db:bookmark": "wrangler d1 time-travel info DB",
    "db:bookmark:dev": "wrangler d1 time-travel info DB --env dev"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "stream-json": "^3.7.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@resvg/resvg-wasm": "^2.6.2"
  }
}
