{
  // ── テンプレート ─────────────────────────────────────────────────────────
  // これは公開用サンプル。実ファイル `wrangler.jsonc` は .gitignore 済みで追跡しない。
  // セットアップ: `cp wrangler.jsonc.sample wrangler.jsonc` してから下記を自分の値へ:
  //   - "name" / "database_name" … 任意のプロジェクト名
  //   - "database_id" … `wrangler d1 create` で発行された ID（REPLACE_WITH_...）
  //   - "RAKUTEN_REFERER" と "routes" の "pattern" … 自分のドメイン（example.com を置換）
  // 個人設定（アフィリ ID / ACCESS_* / ADMIN_EMAILS / 楽天 API キー）は vars ではなく
  // `wrangler secret put <NAME>`（dev は --env dev）で注入する。未設定でも起動はする。
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my100manga",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // workers.dev の *.workers.dev URL を無効化。admin は独自ドメイン上の Cloudflare
  // Access で守るため、Access を通らない workers.dev 経路を残すとバイパスになる。
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 全リクエストで Worker を先に走らせる。理由は 2 つ:
    //   1) admin の HTML（/admin, /admin.html）を Static Assets が直接配信すると
    //      src/adminAuth.ts のガードを素通りするので認証を効かせる。
    //   2) 公開 HTML（index/about/ranking 等）に src/analytics.ts の injectAnalytics で
    //      Google タグ・共通ヘッダー/フッターを差し込む。アセット直配信だと差し込みが走らない。
    // 非 HTML（css/js/画像）は injectAnalytics が content-type を見てそのまま素通りする。
    "run_worker_first": true,
    // 無いパスは public/404.html を 404 で返す（Worker が最後に ASSETS.fetch したとき）。
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // 毎デプロイで変わるバージョン ID を Worker から読めるようにする（env.CF_VERSION.id）。
  // HTML の script に ?v= を付けてキャッシュを破棄し、/api/version と <meta app-version>
  // で開きっぱなしの SPA タブに新デプロイを気付かせる。see src/analytics.ts / public/app.js
  "version_metadata": { "binding": "CF_VERSION" },
  // ── production (deployed by `wrangler deploy`, no --env) ──────────────────
  // デプロイ先ごとの個人設定は公開リポに載せず、すべて
  // `wrangler secret put <NAME>` で注入する（未設定でも起動はする）:
  //   AMAZON_ASSOCIATE_TAG / RAKUTEN_AFFILIATE_ID / MERCARI_AFID / YAHOO_VC_SID / YAHOO_VC_PID
  //     … アフィリンクの紹介タグ。未設定ならタグ無しのリンク（購入は可能）。
  //   RAKUTEN_APP_ID / RAKUTEN_ACCESS_KEY … 楽天 API（表紙フォールバック Tier1）。
  //   YAHOO_APP_ID … Yahoo!ショッピング 商品検索API の Client ID（表紙フォールバック
  //     Tier2、jan_code で ISBN 直引き）。未設定なら Yahoo はスキップ。see src/yahoo.ts
  //   ACCESS_TEAM_DOMAIN / ACCESS_AUD … 自分の Cloudflare Access アプリの値。
  //   ADMIN_EMAILS … 許可メール（カンマ区切り、必須）。未設定・空だと admin は fail-closed で 403。
  //   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET … ユーザの Google ログイン（任意, src/auth.ts）。
  //     未設定ならログインボタンを出さない。リダイレクト URI は <origin>/auth/google/callback。
  // RAKUTEN_REFERER と routes のドメインは公開値なので vars に残す。自分のドメインに変更する。
  "vars": {
    "RAKUTEN_REFERER": "https://example.com/",
    // Google Books cover source: off by default. Set to "true" to re-enable.
    "GOOGLE_ENABLED": "false",
    // ユーザによる表紙URL投稿（「表紙を変更 → 画像URLを直接指定」）: いたずらリスクが
    // 高いので既定で off。"true" で再有効化。see src/corrections.ts coverSuggestionsEnabled
    "COVER_SUGGESTIONS_ENABLED": "false",
    // Google タグ（src/analytics.ts）。公開値なので vars。ADSENSE_CLIENT は AdSense の
    // パブリッシャ ID（"ca-pub-..."）、GTM_CONTAINER_ID は GTM コンテナ ID（"GTM-..."）。
    "ADSENSE_CLIENT": "",
    "GTM_CONTAINER_ID": "",
    // ボット確認（Cloudflare Turnstile, src/turnstile.ts）のサイトキー。公開値なので vars。
    // 対になる TURNSTILE_SECRET は `wrangler secret put TURNSTILE_SECRET` で注入する。
    // 両方空なら無効（リスト公開・通報・データ修正をボット確認なしで受け付ける）。
    "TURNSTILE_SITE_KEY": "",
    // 開発ツール（admin 画面の「DB初期化」= マスターデータ以外を全削除）を有効化。"true" で
    // 表示・実行可能。認証は requireAdmin（Cloudflare Access）が担保するので管理者だけが使える
    // （ADMIN_DEV_BYPASS と違い認証はバイパスしない）。正式リリース時は外す/"false" にする。
    "DEV_TOOLS": "false",
    // サイトの種別（src/site.ts）。"general"＝本家（全年齢）、"adult"＝R18版。R18版は別の Worker
    // （別ドメイン・別 D1/R2/キュー）として env を足し、そちらで "adult" にする（docs/r18.md）。
    "SITE_VARIANT": "general"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my100manga",
      "database_id": "REPLACE_WITH_PROD_DATABASE_ID"
    }
  ],
  // 整形済み表紙（Yahoo!ショッピングの正方形画像から白余白を切り落としたもの）の
  // 永続化先。src/coverBytes.ts が /cover で生成し、正規化した URL のハッシュをキーに put する。
  // ライフサイクル（自動削除）は設定しない（一度作った表紙は永久に使い回す）。
  "r2_buckets": [
    { "binding": "COVERS", "bucket_name": "my100manga-covers" }
  ],
  // 人気傾向の計測（src/popularity.ts）。ノンブロッキング書き込み・自動サンプリング。
  // 集計は Cloudflare の Analytics Engine SQL API 経由（Account API トークンが別途必要）。
  "analytics_engine_datasets": [
    { "binding": "POPULARITY", "dataset": "my100manga_popularity" }
  ],
  // Global 1 req/s coordinator for Rakuten API calls (src/ratelimiter.ts).
  // Bindings are non-inheritable, so this block is repeated under env.dev.
  "durable_objects": {
    "bindings": [
      { "name": "RAKUTEN_LIMITER", "class_name": "RakutenRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RakutenRateLimiter"] }
  ],
  // 公開書き込み系の濫用よけ（src/ratelimit.ts）。IP 単位・per-colo のカウント。
  // RL_WRITE はリスト作成/更新・通報・修正などの書き込み全般、RL_COVERS は外部 API や重い
  // クエリを叩くもの（/api/covers・/cover の R2 ミス・検索・候補・/api/book・共有画像の生成）用。
  // RL_COVERS はキーの bucket 名をエンドポイントごとに分けているので、limit は各々に効く。
  // RL_HEAVY は MADB を全文検索する /api/live-search 用のさらに狭い枠。
  // period は 10 か 60 のみ。namespace_id は任意の一意値。
  "ratelimits": [
    { "name": "RL_WRITE", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_COVERS", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_HEAVY", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // 共有画像（src/shareImage.ts）の事前生成キュー。og は公開時に waitUntil で描き、残りの
  // full/q1–q4 はリストの作成/更新で {slug, host, updated_at} を 60 秒遅延で積んで、同じ Worker の
  // queue() が 1 枚ずつ描いて R2 に置く。描画はメモリを食う（isolate 128MB）ので batch 1・並列 1。
  // キューは事前に `wrangler queues create <name>` で作る（閲覧ビーコンの my100manga-views も同様）。
  // binding が無ければ og だけ描く。閲覧ビーコンは binding が無ければその場で D1 に書く。
  "queues": {
    "producers": [
      { "binding": "SHARE_QUEUE", "queue": "my100manga-share" },
      { "binding": "VIEW_QUEUE", "queue": "my100manga-views" }
    ],
    "consumers": [
      {
        "queue": "my100manga-share",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3
      },
      // 閲覧ビーコン（src/publicLists.ts）。100 件か 10 秒でまとめて D1 に書く。キュー名は
      // src/index.ts の VIEW_QUEUE_PREFIX で始めること（consumer の振り分けに使う）。
      {
        "queue": "my100manga-views",
        "max_batch_size": 100,
        "max_batch_timeout": 10,
        "max_concurrency": 1,
        "max_retries": 3
      }
    ]
  },
  // 売上ランキングの日次スナップショット（src/salesRanking.ts）。毎日 05:00 JST（20:00 UTC）。
  // triggers は env に継承されるので、dev は env.dev 側で空にして止めている。
  "triggers": { "crons": ["0 20 * * *"] },
  "routes": [
    { "pattern": "example.com", "custom_domain": true }
  ],
  // ── dev (deployed by `wrangler deploy --env dev`) ────────────────────────
  // Non-inheritable keys (vars / d1_databases / routes) must be repeated here;
  // inheritable ones (main / assets / compatibility_date / observability) are
  // taken from the top level. Worker name becomes `my100manga-dev`.
  "env": {
    "dev": {
      // 個人設定（アフィリ ID / ACCESS_* / ADMIN_EMAILS）は dev でも secret で注入する
      // （`wrangler secret put <NAME> --env dev`）。トップレベル vars のコメント参照。
      "vars": {
        "RAKUTEN_REFERER": "https://dev.example.com/",
        "GOOGLE_ENABLED": "false",
        "COVER_SUGGESTIONS_ENABLED": "false",
        "ADSENSE_CLIENT": "",
        "GTM_CONTAINER_ID": "",
        "TURNSTILE_SITE_KEY": "",
        "DEV_TOOLS": "false",
        "SITE_VARIANT": "general"
      },
      "version_metadata": { "binding": "CF_VERSION" },
      // dev では売上ランキングの Cron を止める（毎日楽天を叩くだけで無駄なので）。
      // 必要なら管理画面の手動取得（POST /api/admin/sales-ranking/snapshot）で取る。
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "my100manga-dev",
          "database_id": "REPLACE_WITH_DEV_DATABASE_ID"
        }
      ],
      "r2_buckets": [
        { "binding": "COVERS", "bucket_name": "my100manga-covers-dev" }
      ],
      "analytics_engine_datasets": [
        { "binding": "POPULARITY", "dataset": "my100manga_popularity_dev" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RAKUTEN_LIMITER", "class_name": "RakutenRateLimiter" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RakutenRateLimiter"] }
      ],
      "ratelimits": [
        { "name": "RL_WRITE", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_COVERS", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_HEAVY", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
      ],
      "queues": {
        "producers": [
          { "binding": "SHARE_QUEUE", "queue": "my100manga-share-dev" },
          { "binding": "VIEW_QUEUE", "queue": "my100manga-views-dev" }
        ],
        "consumers": [
          {
            "queue": "my100manga-share-dev",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 3
          },
          {
            "queue": "my100manga-views-dev",
            "max_batch_size": 100,
            "max_batch_timeout": 10,
            "max_concurrency": 1,
            "max_retries": 3
          }
        ]
      },
      "routes": [
        { "pattern": "dev.example.com", "custom_domain": true }
      ]
    },
    // ── R18版 (deployed by `wrangler deploy --env r18` / `--env r18dev`) ─────
    // 本家と同じコードを別 Worker として出す（docs/r18.md）。SITE_VARIANT="adult" 以外の
    // 違いは「本家と混ざらないよう別の入れ物を持つ」だけ。非継承キー（name / vars /
    // d1_databases / r2_buckets / analytics_engine_datasets / durable_objects / migrations /
    // ratelimits / queues / routes）は全部書く。triggers は**継承される**ので、売上ランキング
    // の Cron を止めるために空で上書きする。
    // 事前に作るもの: D1・R2 バケット・Queue 2 本（`wrangler queues create`）・R18 ドメイン用の
    // Cloudflare Access アプリ・Google OAuth クライアント・Turnstile のホスト名登録。
    // 注意: 閲覧ビーコンの consumer 振り分けは src/index.ts の VIEW_QUEUE_PREFIX
    // （"my100manga-views" 直書き）で見ているので、下の queue 名にするなら先にそこを直す。
    "r18": {
      "name": "my100shunga",
      "vars": {
        "RAKUTEN_REFERER": "https://my100shunga.com/",
        "GOOGLE_ENABLED": "false",
        "COVER_SUGGESTIONS_ENABLED": "false",
        // AdSense は成人向けコンテンツ不可。R18版では必ず空のままにする（docs/r18.md）。
        "ADSENSE_CLIENT": "",
        "GTM_CONTAINER_ID": "",
        "TURNSTILE_SITE_KEY": "",
        "DEV_TOOLS": "false",
        "SITE_VARIANT": "adult"
      },
      "version_metadata": { "binding": "CF_VERSION" },
      // 売上ランキング（楽天ブックスの一般書籍）は R18版では使わないので Cron を止める。
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "my100shunga",
          "database_id": "REPLACE_WITH_R18_DATABASE_ID"
        }
      ],
      "r2_buckets": [
        { "binding": "COVERS", "bucket_name": "my100shunga-covers" }
      ],
      "analytics_engine_datasets": [
        { "binding": "POPULARITY", "dataset": "my100shunga_popularity" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RAKUTEN_LIMITER", "class_name": "RakutenRateLimiter" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RakutenRateLimiter"] }
      ],
      // namespace_id は本家と別の値にする（同じ値だと枠を食い合う）。
      "ratelimits": [
        { "name": "RL_WRITE", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_COVERS", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_HEAVY", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
      ],
      "queues": {
        "producers": [
          { "binding": "SHARE_QUEUE", "queue": "my100shunga-share" },
          { "binding": "VIEW_QUEUE", "queue": "my100shunga-views" }
        ],
        "consumers": [
          {
            "queue": "my100shunga-share",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 3
          },
          {
            "queue": "my100shunga-views",
            "max_batch_size": 100,
            "max_batch_timeout": 10,
            "max_concurrency": 1,
            "max_retries": 3
          }
        ]
      },
      "routes": [
        { "pattern": "my100shunga.com", "custom_domain": true }
      ]
    },
    "r18dev": {
      "name": "my100shunga-dev",
      "vars": {
        "RAKUTEN_REFERER": "https://dev.my100shunga.com/",
        "GOOGLE_ENABLED": "false",
        "COVER_SUGGESTIONS_ENABLED": "false",
        "ADSENSE_CLIENT": "",
        "GTM_CONTAINER_ID": "",
        "TURNSTILE_SITE_KEY": "",
        "DEV_TOOLS": "false",
        "SITE_VARIANT": "adult"
      },
      "version_metadata": { "binding": "CF_VERSION" },
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "my100shunga-dev",
          "database_id": "REPLACE_WITH_R18_DEV_DATABASE_ID"
        }
      ],
      "r2_buckets": [
        { "binding": "COVERS", "bucket_name": "my100shunga-covers-dev" }
      ],
      "analytics_engine_datasets": [
        { "binding": "POPULARITY", "dataset": "my100shunga_popularity_dev" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RAKUTEN_LIMITER", "class_name": "RakutenRateLimiter" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RakutenRateLimiter"] }
      ],
      "ratelimits": [
        { "name": "RL_WRITE", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_COVERS", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_HEAVY", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
      ],
      "queues": {
        "producers": [
          { "binding": "SHARE_QUEUE", "queue": "my100shunga-share-dev" },
          { "binding": "VIEW_QUEUE", "queue": "my100shunga-views-dev" }
        ],
        "consumers": [
          {
            "queue": "my100shunga-share-dev",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 3
          },
          {
            "queue": "my100shunga-views-dev",
            "max_batch_size": 100,
            "max_batch_timeout": 10,
            "max_concurrency": 1,
            "max_retries": 3
          }
        ]
      },
      "routes": [
        { "pattern": "dev.my100shunga.com", "custom_domain": true }
      ]
    }
  }
}
